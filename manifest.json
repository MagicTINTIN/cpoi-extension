{
    "manifest_version": 3,
    "name": "CPOI",
    "version": "1.1.0",
    "author": "MagicTINTIN",
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "action": {
        "default_popup": "src/menu.html"
    },
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "cpoi@softplus.fr",
            "strict_min_version": "109.0"
        }
    }
}